{
  "name": "idcard-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "test": "bun test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "probe": "bun src/server/pcsc-cli.ts"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.19",
    "iconv-lite": "0.7.3",
    "koffi": "3.3.5",
    "solid-js": "2.0.0-rc.19"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
